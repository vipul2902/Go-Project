# Copy to .env for local development. Never commit .env.
# Generate passwords with: openssl rand -hex 24

# development | staging | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s

# PostgreSQL (docker compose reads POSTGRES_PASSWORD from this file)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://clouddeploy:change-me@127.0.0.1:15432/clouddeploy?sslmode=disable
TEST_DATABASE_URL=postgres://clouddeploy:change-me@127.0.0.1:15432/clouddeploy_test?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# Password for all seeded development users (make seed). Development only.
SEED_PASSWORD=change-me-dev-only

# Added in later phases:
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=<openssl rand -base64 48>
