# Copy to .env for local development. Never commit .env.
# Generate passwords with: openssl rand -hex 24

# development | staging | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s

# PostgreSQL (docker compose reads POSTGRES_PASSWORD from this file)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://clouddeploy:change-me@127.0.0.1:15432/clouddeploy?sslmode=disable
TEST_DATABASE_URL=postgres://clouddeploy:change-me@127.0.0.1:15432/clouddeploy_test?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# Password for all seeded development users (make seed). Development only.
SEED_PASSWORD=change-me-dev-only

# Auth. JWT_SECRET must be >= 32 bytes: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# CIDRs of reverse proxies allowed to set X-Forwarded-For (empty: none).
TRUSTED_PROXY_CIDRS=

# Redis (rate limiting; job queue from Phase 8). Port 16379 avoids a native Redis.
REDIS_URL=redis://127.0.0.1:16379/0
TEST_REDIS_URL=redis://127.0.0.1:16379/15

# Kubernetes context for monitoring (API) and deploying (worker) when running
# outside a cluster. Empty: API monitoring endpoints answer 503.
KUBE_CONTEXT=colima
