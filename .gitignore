# Build output
/bin/
/dist/
*.test
*.out
coverage.*

# Secrets / local config — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
kubeconfig*

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
*.tfplan

# Frontend
node_modules/
web/dist/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local image tags written by make k8s-images
.k8s-image-tag
.k8s-builder-tag
.k8s-web-tag

# Terraform backend settings (storage account names etc.)
backend.hcl
deploy/helm/clouddeploy/values-azure.generated.yaml

# Local-only Terraform overrides (e.g. local state for a trial plan)
*_override.tf

# Performance run output (make perf)
.perf/
