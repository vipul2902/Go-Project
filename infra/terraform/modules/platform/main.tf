# Platform: everything CloudDeploy needs in one Azure environment. The
# envs/<name> roots call this module with their own sizing, so dev, staging
# and prod share one definition and differ only in inputs.
#
# Secrets never reach the state file: passwords are generated by EPHEMERAL
# resources (re-created on every run, never persisted) and written to
# WRITE-ONLY arguments, which Azure receives but Terraform does not store.

terraform {
  required_version = ">= 1.11"
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 4.40" }
    random  = { source = "hashicorp/random", version = "~> 3.7" }
  }
}

data "azurerm_client_config" "current" {}

locals {
  name = "clouddeploy-${var.environment}"
  # Globally unique names (ACR, Key Vault) get a short, stable suffix.
  compact = "cd${substr(var.environment, 0, 4)}${var.name_suffix}"
  tags = merge(var.tags, {
    application = "clouddeploy"
    environment = var.environment
    managed-by  = "terraform"
  })
  is_production = var.environment == "production"
  # Must match the Helm chart's service account names (release "clouddeploy").
  service_accounts = ["clouddeploy-api", "clouddeploy-worker", "clouddeploy-migrate"]
}

resource "azurerm_resource_group" "this" {
  name     = "rg-${local.name}"
  location = var.location
  tags     = local.tags
}

# Production: a CanNotDelete lock on the resource group stops an accidental
# `terraform destroy` or portal click from removing the database. It must be
# removed deliberately (a separate, reviewed change) before teardown.
resource "azurerm_management_lock" "no_delete" {
  count      = local.is_production ? 1 : 0
  name       = "no-delete"
  scope      = azurerm_resource_group.this.id
  lock_level = "CanNotDelete"
  notes      = "Production data. Remove this lock in a reviewed change before any teardown."
}

module "network" {
  source              = "../network"
  name                = local.name
  location            = var.location
  resource_group_name = azurerm_resource_group.this.name
  address_space       = var.address_space
  tags                = local.tags
}

module "acr" {
  source              = "../acr"
  name                = "${local.compact}acr"
  location            = var.location
  resource_group_name = azurerm_resource_group.this.name
  sku                 = var.acr_sku
  tags                = local.tags
}

module "aks" {
  source                 = "../aks"
  name                   = local.name
  location               = var.location
  resource_group_name    = azurerm_resource_group.this.name
  subnet_id              = module.network.aks_subnet_id
  acr_id                 = module.acr.id
  kubernetes_version     = var.kubernetes_version
  sku_tier               = var.aks_sku_tier
  node_vm_size           = var.aks_node_vm_size
  node_count             = var.aks_node_count
  zones                  = var.zones
  admin_group_object_ids = var.aks_admin_group_object_ids
  tags                   = local.tags
}

ephemeral "random_password" "postgres" {
  length  = 40
  special = false # stays URL-safe inside DATABASE_URL
}

# The API and worker's own login (member of clouddeploy_app: row access
# only), created in-cluster by the migrate job; see migration 00010.
ephemeral "random_password" "app_db" {
  length  = 40
  special = false
}

ephemeral "random_password" "jwt" {
  length  = 64
  special = false
}

module "postgres" {
  source                 = "../postgres"
  name                   = local.name
  location               = var.location
  resource_group_name    = azurerm_resource_group.this.name
  subnet_id              = module.network.postgres_subnet_id
  private_dns_zone_id    = module.network.dns_zone_ids["postgres"]
  administrator_password = ephemeral.random_password.postgres.result
  password_version       = var.secrets_version
  sku_name               = var.postgres_sku
  storage_mb             = var.postgres_storage_mb
  backup_retention_days  = var.postgres_backup_retention_days
  geo_redundant_backup   = var.postgres_geo_redundant_backup
  high_availability      = var.postgres_high_availability
  tags                   = local.tags
}

module "redis" {
  source                     = "../redis"
  name                       = local.name
  location                   = var.location
  resource_group_name        = azurerm_resource_group.this.name
  private_endpoint_subnet_id = module.network.private_endpoint_subnet_id
  private_dns_zone_id        = module.network.dns_zone_ids["redis"]
  sku_name                   = var.redis_sku
  high_availability          = var.redis_high_availability
  tags                       = local.tags
}

module "keyvault" {
  source                     = "../keyvault"
  name                       = "${local.compact}kv"
  location                   = var.location
  resource_group_name        = azurerm_resource_group.this.name
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  private_endpoint_subnet_id = module.network.private_endpoint_subnet_id
  private_dns_zone_id        = module.network.dns_zone_ids["keyvault"]
  purge_protection           = local.is_production
  public_network_access      = length(var.operator_ip_ranges) > 0
  allowed_ip_ranges          = var.operator_ip_ranges
  oidc_issuer_url            = module.aks.oidc_issuer_url
  workload_namespace         = "clouddeploy"
  workload_service_accounts  = local.service_accounts
  tags                       = local.tags
}

# Whoever runs Terraform (a person or the CD pipeline's identity) needs to
# write the secrets below.
# The worker's identity may run ACR Tasks builds; no other workload can.
resource "azurerm_role_assignment" "worker_builds" {
  scope              = module.acr.id
  role_definition_id = module.acr.task_runner_role_id
  principal_id       = module.keyvault.workload_principal_ids["clouddeploy-worker"]
}

resource "azurerm_role_assignment" "deployer_secrets_officer" {
  scope                = module.keyvault.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = data.azurerm_client_config.current.object_id
}

locals {
  # Built from ephemeral values, so these locals are ephemeral too and can
  # only flow into write-only arguments.
  app_secrets = {
    # API and worker: least-privilege login. Migrate job: server admin, which
    # also creates that login with app-db-password.
    "database-url"         = "postgres://clouddeploy_api:${ephemeral.random_password.app_db.result}@${module.postgres.fqdn}:5432/${module.postgres.database}?sslmode=require"
    "migrate-database-url" = "postgres://${module.postgres.administrator_login}:${ephemeral.random_password.postgres.result}@${module.postgres.fqdn}:5432/${module.postgres.database}?sslmode=require"
    "app-db-password"      = ephemeral.random_password.app_db.result
    "redis-url"            = "rediss://:${module.redis.primary_access_key}@${module.redis.hostname}:${module.redis.port}/0"
    "jwt-secret"           = ephemeral.random_password.jwt.result
  }
}

resource "azurerm_key_vault_secret" "app" {
  for_each         = toset(keys(local.app_secrets))
  name             = each.key
  key_vault_id     = module.keyvault.id
  value_wo         = local.app_secrets[each.key]
  value_wo_version = var.secrets_version
  content_type     = "text/plain"
  depends_on       = [azurerm_role_assignment.deployer_secrets_officer]
}

check "production_is_resilient" {
  assert {
    condition = !local.is_production || (
      var.postgres_high_availability && var.postgres_geo_redundant_backup &&
      var.redis_high_availability && var.aks_sku_tier == "Standard" && length(var.zones) >= 2
    )
    error_message = "Production should run zone-redundant PostgreSQL with geo-redundant backups, HA Redis, the Standard AKS tier and at least two zones."
  }
}
