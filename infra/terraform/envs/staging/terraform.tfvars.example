# Copy to terraform.tfvars (git-ignored). Nothing here is a secret: secrets
# are generated by Terraform as ephemeral values and stored in Key Vault.
name_suffix = "abc123"                 # 3-8 chars; makes ACR/Key Vault names globally unique
operator_ip_ranges = ["203.0.113.10/32"] # your public IP, so Terraform can write Key Vault secrets
aks_admin_group_object_ids = []        # Entra ID group object IDs for cluster-admin
